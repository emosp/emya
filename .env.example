# 英文品牌名 如 emos
APP_NAME=emya
# 授权人数 默认10人
APP_AUTH_NUMBER=10

# 服务相关
## 监听地址
SERVER_HOST=0.0.0.0
## 监听端口
SERVER_PORT=8096

# 数据库相关 暂只支持 mysql / mariadb
## 数据库地址
DB_HOST=
## 数据库端口
DB_PORT=3306
## 数据库表名
DB_DATABASE=
## 数据库用户名
DB_USERNAME=
## 数据库密码
DB_PASSWORD=

# redis缓存
## valkey地址
VALKEY_HOST=
## valkey端口
VALKEY_PORT=6379
## valkey密码
VALKEY_PASSWORD=

# api相关
## 外部调用我的key
API_KEY=
## 外部接口地址 末尾不带/ 如 http://127.0.0.1:8000/emya 没有留空即可
API_EXTERNAL=

# 其他
## 默认搜索展示内容 json 格式 key为名称 value为 video_list 表中id
SEARCH_DEFAULT_LIST={"欢迎来到emya":1,"感谢大家支持":1,"自己追的剧记得看完哦":2}

# emby 其他服务器地址 https://github.com/uhdnow/emby_ext_domains
EMBY_EXT_SERVER_DOMAINS=[{"name":"默认","url":"https://emya.local"}]

# TMDB 图片设置
## 图片镜像源（留空默认 https://image.tmdb.org，国内可配置反代镜像加速海报加载）
TMDB_IMAGE_MIRROR=
## 图片清晰度级别（默认 original 超清原画，可选 w500, w780 等）
TMDB_IMAGE_SIZE=original
